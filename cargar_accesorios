import pandas as pd
from sqlalchemy import create_engine, text

engine = create_engine('postgresql://postgres:Pistache07@127.0.0.1:5432/Sistemitas')

# REVISA QUE ESTE NOMBRE SEA EL CORRECTO EN TU CARPETA C:\py\
ruta_accesorios = r"C:\py\inventario_accesorios.xlsx" 

def vincular_accesorios():
    try:
        # 1. Obtener los usuarios de la base de datos para saber sus IDs
        usuarios = pd.read_sql("SELECT empleadoid, nombre, apellidop FROM usuario", engine)
        dict_usuarios = {
            f"{str(row['nombre']).upper().strip()} {str(row['apellidop']).upper().strip()}": row['empleadoid'] 
            for _, row in usuarios.iterrows()
        }

        # 2. Leer el Excel de accesorios
        df_a = pd.read_excel(ruta_accesorios)
        actualizados = 0

        with engine.connect() as conn:
            for _, fila in df_a.iterrows():
                # Armamos el nombre igual que en el diccionario
                nombre_completo = f"{str(fila['Nombre']).upper().strip()} {str(fila['Apellido paterno']).upper().strip()}"
                u_id = dict_usuarios.get(nombre_completo)
                
                if u_id:
                    conn.execute(
                        text("UPDATE accesorio SET empleadoid = :uid WHERE numeroserie = :serie"),
                        {"uid": u_id, "serie": fila['Número de serie']}
                    )
                    actualizados += 1
            conn.commit()
        
        print(f"✅ Se vincularon {actualizados} accesorios con sus dueños.")

    except Exception as e:
        print(f"❌ Error: {e}")

vincular_accesorios()